# Copy to back/.env and fill in. back/.env is git-ignored: never commit the key.
# Key from the Meta Model API dashboard: https://dev.meta.ai/ -> API keys
LLM_API_KEY=

# Optional overrides: any OpenAI-compatible chat API works
LLM_MODEL=muse-spark-1.3
LLM_BASE_URL=https://api.meta.ai/v1
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

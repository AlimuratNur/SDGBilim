# Copy to back/.env and fill in. back/.env is git-ignored: never commit the key.

# Which API answers: "anthropic" (Claude) or "openai" (any OpenAI-compatible API:
# Meta Model API, Gemini, DeepSeek...).
LLM_PROVIDER=openai
# The key of that provider. Claude: https://platform.claude.com/settings/keys
# Meta Model API: https://dev.meta.ai/ -> API keys
LLM_API_KEY=

# Optional. Empty means the provider's default:
#   anthropic: claude-haiku-5-5, the Anthropic endpoint
#   openai:    muse-spark-1.3, https://api.meta.ai/v1
LLM_MODEL=
LLM_BASE_URL=

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
